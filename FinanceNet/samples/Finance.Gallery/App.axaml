<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Finance.Gallery.App"
             RequestedThemeVariant="Dark">

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif" />
    </Style>

    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#9AA8BD" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#172033" />
    </Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E2A47" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Foreground" Value="#E6EDF7" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#6366F1" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#7C7FF5" />
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#172033" />
      <Setter Property="Foreground" Value="#E6EDF7" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="BorderBrush" Value="#243047" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TextBox, ComboBox, NumericUpDown">
      <Setter Property="CornerRadius" Value="7" />
    </Style>

    <Style Selector="Slider">
      <Setter Property="Foreground" Value="#6366F1" />
    </Style>
  </Application.Styles>

</Application>
