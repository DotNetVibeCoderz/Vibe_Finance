<Project>

  <!--
    Finance.Net - shared MSBuild settings for every project in the solution.
    Dibuat oleh Gravicode Studios, dipimpin oleh Kang Fadhil.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <VersionPrefix>0.9.0</VersionPrefix>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <!-- NuGet metadata shared by every shipping library under src/. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('$([System.IO.Path]::DirectorySeparatorChar)src$([System.IO.Path]::DirectorySeparatorChar)'))">
    <IsPackable>true</IsPackable>
    <PackageId>Gravicode.$(MSBuildProjectName)</PackageId>
    <Authors>Gravicode Studios</Authors>
    <Company>Gravicode Studios</Company>
    <Product>Finance.Net</Product>
    <Copyright>Copyright (c) Gravicode Studios</Copyright>
    <PackageProjectUrl>https://github.com/DotNetVibeCoderz/Vibe_Finance/tree/main/FinanceNet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DotNetVibeCoderz/Vibe_Finance</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>finance;quant;trading;risk;portfolio;backtesting;options;dotnet;rust;gravicode</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <Description>Finance.Net - complete quantitative finance library for .NET 10. Dibuat oleh Gravicode Studios, dipimpin oleh Kang Fadhil.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" Condition="Exists('$(MSBuildThisFileDirectory)README.md')" />
    <None Include="$(MSBuildThisFileDirectory)assets/icon.png" Pack="true" PackagePath="\" Visible="false" Condition="Exists('$(MSBuildThisFileDirectory)assets/icon.png')" />
  </ItemGroup>

  <PropertyGroup Condition="'$(IsPackable)' != 'true'">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Tests: xUnit1051 (pass TestContext cancellation tokens) is noise for these short, offline tests. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('$([System.IO.Path]::DirectorySeparatorChar)tests$([System.IO.Path]::DirectorySeparatorChar)'))">
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>


</Project>
