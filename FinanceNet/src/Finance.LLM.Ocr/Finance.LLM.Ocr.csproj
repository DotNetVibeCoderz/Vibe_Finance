<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Finance.LLM.Ocr</RootNamespace>
    <Description>Finance.Net OCR for scanned reports: printed-text line detection and TrOCR recognition run in-process through HF.Net (Gravicode.HFNet.GraviTransformers.Vision), plus a PDF loader that OCRs pages without a text layer for filings Q&amp;A. A separate package because it depends on SixLabors.ImageSharp. Dibuat oleh Gravicode Studios, dipimpin oleh Kang Fadhil.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Finance.LLM/Finance.LLM.csproj" />
    <PackageReference Include="Gravicode.HFNet.GraviTransformers.Vision" />
    <PackageReference Include="Gravicode.OfficeNet.PdfNet" />
    <InternalsVisibleTo Include="Finance.AI.Tests" />
  </ItemGroup>

  <!--
    SixLabors.ImageSharp 3.1.12 (through GraviTransformers.Vision) has five advisories fixed only in the licence-keyed
    4.x line. None is reachable from this package:
    - BigTIFF IFD loop (GHSA-wmxv-xphr-5c9g), ICC CLUT parsing (GHSA-gwg2-r3hj-4w44): page images are decoded with
      ScannedPageOcr.Decoding - PNG/JPEG/BMP/GIF/WebP only, metadata skipped - and HF.Net's processor does the same.
    - TIFF CCITT T4/T6 encoders (GHSA-j3p4-wp97-rph4, GHSA-j9gm-c75j-xc9q), HistogramEqualization (GHSA-jjfr-hcj7-qf5w):
      nothing here encodes TIFF or equalises histograms.
    This is the only Finance.Net package that depends on ImageSharp.
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
  </ItemGroup>

</Project>
